{
  "_meta": {
    "description": "Hand-labeled structural ground truth for all specimens. Unlike the auto-generated GT in benchmark_runner.py, every entry here was labeled by inspecting the file contents.",
    "schema": {
      "header_rows": "[first, last] inclusive row indices of the header block, or null for headerless tables",
      "stub_end": "exclusive absolute column index where the stub (row-label/id columns) ends; stub_end == left means no stub",
      "top": "first data row (inclusive), AFTER the header block",
      "bottom": "last data row (inclusive); trailing summary rows excluded where possible (to_long also skips them by keyword)",
      "left": "first column (inclusive)",
      "right": "last column (exclusive)"
    },
    "labeling_principles": [
      "stub = leading identifier/label columns, including numeric IDs and year columns when they clearly key the row (03, 08, 14, 17, cyclones, population_deaths, warehouse...)",
      "units rows and spanning label rows adjacent to the header belong to the header block (02, 12, 17, 20, population_deaths, occupational_health)",
      "title rows, footnotes, legends, and side annotation columns are excluded from the region (08 col 7, 19, occupational_health col 0)",
      "interspersed subtotal/total rows are inside the row range where unavoidable; to_long/clean skip them via summary keywords (05, 15)"
    ],
    "labeled": "2026-07-05",
    "revisions": {
      "2026-07-05b": "occupational_health header block narrowed from rows 3-5 to 4-5: row 3's 'Sex and Age Group' is a spanning super-label whose omission yields cleaner tidy output (['Audiometric Test','Male','15-24',53]); matches the recursive-segmentation detector and keeps testbed manifest.json 4/4."
    }
  },
